# Copie este arquivo para .env e preencha com suas chaves reais.
# O .env NUNCA vai para o Git (esta no .gitignore).

ANTHROPIC_API_KEY=coloque-sua-chave-anthropic-aqui
OPENAI_API_KEY=coloque-sua-chave-openai-aqui

# Nomes de modelo ficam em config, nao no codigo.
# Ajuste para os modelos que voce tem acesso.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-5.1

# Observabilidade (aula 0.7) - OPCIONAL.
# Sem estas chaves, so o rastreador local roda e nada quebra.
# Pegue as chaves em Settings > API Keys no projeto do Langfuse.
# LANGFUSE_HOST: https://cloud.langfuse.com (UE), https://us.cloud.langfuse.com (EUA)
# ou a URL da sua instancia self-hosted.
LANGFUSE_PUBLIC_KEY=pk-lf-coloque-sua-chave-publica-aqui
LANGFUSE_SECRET_KEY=sk-lf-coloque-sua-chave-secreta-aqui
LANGFUSE_HOST=https://cloud.langfuse.com
